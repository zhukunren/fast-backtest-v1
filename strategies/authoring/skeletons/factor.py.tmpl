def _compute_panel_signals(df: pd.DataFrame) -> tuple[pd.Series, pd.Series, pd.DataFrame]:
    out = factor_engine(df)
    if "factor_value" not in out.columns:
        raise ValueError("factor_engine() must produce factor_value")
    out["factor_value"] = pd.to_numeric(out["factor_value"], errors="coerce")
    buy_cond, sell_cond = factor_entry_exit_rules(out)
    return buy_cond, sell_cond, out
