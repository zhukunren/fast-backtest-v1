# Local environment template. The application does not require this file and
# does not load it automatically; set variables in the shell or your secret
# manager. Never commit a populated .env file.

# Full-workspace data integrations
MYSQL_PASSWORD=
TUSHARE_TOKEN=
TS_TOKEN=

# Web maintenance (use a high-entropy value of at least 32 characters in
# production; keep the Web bound to loopback for local development)
WEB_ADMIN_TOKEN=
WEB_HOST=127.0.0.1
WEB_PORT=5000
WEB_PUBLIC_ORIGIN=
WEB_CORS_ORIGINS=

# Optional AI integrations
QWEN_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
